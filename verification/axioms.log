'WRC.wrc' depends on axioms: [propext, Classical.choice, Quot.sound]
WRC.wrc : WRC.WRCStatement
WRC.standard_wrc : WRC.StandardWRCStatement
WRC.terminal_rho_lt_half {n k : ℕ} (h : WRC.FirstHit n k) : WRC.rho n k < 1 / 2
WRC.finite_termination_and_residual (n : ℕ) (hn : 0 < n) (hsize : n ≤ 2 ^ 26) :
  ∃ k, WRC.FirstHit n k ∧ WRC.residual n k < 63 / 50
'WRC.doe' depends on axioms: [propext, Classical.choice, Quot.sound]
WRC.doe {n t : ℕ} (h : WRC.CFirstHit n t) :
  ↑(WRC.oddCount n t) = ⌊Real.logb 6 2 * ↑t - Real.logb 6 ↑n⌋ ∧
    ↑(WRC.evenCount n t) = ⌈Real.logb 6 3 * ↑t + Real.logb 6 ↑n⌉ ∧
      ↑t = ⌈Real.logb 2 6 * ↑(WRC.oddCount n t) + Real.logb 2 ↑n⌉ ∧
        ↑(WRC.evenCount n t) = ⌈Real.logb 2 3 * ↑(WRC.oddCount n t) + Real.logb 2 ↑n⌉ ∧
          ↑t = ⌊Real.logb 3 6 * ↑(WRC.evenCount n t) - Real.logb 3 ↑n⌋ ∧
            ↑(WRC.oddCount n t) = ⌊Real.logb 3 2 * ↑(WRC.evenCount n t) - Real.logb 3 ↑n⌋
WRC.doe_total_from_odd {n t : ℕ} (h : WRC.CFirstHit n t) : ↑t = ⌈Real.logb 2 6 * ↑(WRC.oddCount n t) + Real.logb 2 ↑n⌉
